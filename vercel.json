{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/home", "dest": "/index.html" },
    { "src": "/auth", "dest": "/auth.html" },
    { "src": "/chat", "dest": "/chat.html" },
    { "src": "/settings", "dest": "/settings.html" },
    { "src": "/workspace", "dest": "/workspace.html" },
    { "src": "/api/(.*)", "dest": "/server.js" }
  ]
}
